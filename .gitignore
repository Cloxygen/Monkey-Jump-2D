# This .gitignore file is custom-tailored for Unity projects.
# It ensures that temporary files, user settings, and cache files are ignored,
# while preserving important game assets, metadata, and packages.

# ==========================================
# Unity-specific files and folders
# ==========================================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emory[Cc]aptures/
/[Uu]serSettings/
.utmp/

# Asset Store cache and packages
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Android/assets*

# Autogenerated VS/MD/Consolas solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.tlog

# Unity crash logs and reports
sysinfo.txt
crashlytics-build.properties

# ==========================================
# IDE and OS-specific files
# ==========================================
# Visual Studio
.vs/
.vsconfig

# Rider
.idea/
*.sln.iml

# Visual Studio Code
.vscode/

# Windows OS metadata
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini

# macOS OS metadata
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# ==========================================
# Builds and Package Managers
# ==========================================
*.apk
*.unitypackage
*.app
*.ipa
